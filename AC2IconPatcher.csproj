<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AC2IconPatcher</AssemblyName>
    <RootNamespace>AC2IconPatcher</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The default recursive glob would otherwise also pick up the test project's files. -->
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <!-- No NuGet dependencies - runs on plain .NET SDK. -->

</Project>
